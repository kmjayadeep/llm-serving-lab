# Image tested on 2026-09-12. Check AMD's current Radeon vLLM docs before upgrading.
VLLM_IMAGE=rocm/vllm-dev:rocm7.2.1_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.16.0
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
SERVED_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# rocminfo/PyTorch listed the discrete RX 7900 GRE as device 0 and the APU as 1.
HIP_VISIBLE_DEVICES=0
DTYPE=float16
MAX_MODEL_LEN=2048
GPU_MEMORY_UTILIZATION=0.75
PORT=8000
OPEN_WEBUI_PORT=3000

# Optional for gated models. Do not commit the real token.
HF_TOKEN=
